{
  "name": "rest-express",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "start": "turbo run start",
    "check": "turbo run check",
    "db:push": "turbo run db:push",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:client": "NODE_OPTIONS='--experimental-vm-modules' jest --selectProjects client",
    "test:server": "NODE_OPTIONS='--experimental-vm-modules' jest --selectProjects server",
    "test:legacy": "NODE_OPTIONS='--experimental-vm-modules' jest --selectProjects legacy"
  },
  "devDependencies": {
    "ts-node": "^10.9.1",
    "turbo": "^1.13.4",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agent-runtime": "^3.954.0",
    "@aws-sdk/client-bedrock-runtime": "^3.954.0",
    "@aws-sdk/client-s3": "^3.962.0",
    "@fontsource/inter": "^5.2.5",
    "@neondatabase/serverless": "^0.10.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/multer": "^2.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^6.0.3",
    "@types/testing-library__jest-dom": "^5.14.9",
    "drizzle-kit": "^0.30.4",
    "drizzle-orm": "^0.39.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "leaflet": "^1.9.4",
    "msw": "^2.12.4",
    "multer": "^2.0.2",
    "papaparse": "^5.5.3",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "vite": "^5.4.19",
    "xlsx": "^0.18.5"
